# Copy this file to .env and adjust values for your environment.
# The backend loads it automatically via python-dotenv (app/core/config.py).

# SQLAlchemy connection string for PostgreSQL (psycopg v3 driver).
# Matches the Docker Compose setup (backend/docker-compose.yml):
#   POSTGRES_DB=crimelink
#   POSTGRES_USER=crimelink
#   POSTGRES_PASSWORD=crimelink_dev
DATABASE_URL=postgresql+psycopg://crimelink:crimelink_dev@localhost:5432/crimelink

# Neo4j (Bolt) connection settings. Matches the Docker Compose Neo4j service
# (NEO4J_AUTH=neo4j/crimelink_dev).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=crimelink_dev

# Entity resolution thresholds (RapidFuzz similarity 0-100).
ENTITY_MATCH_THRESHOLD=85
ENTITY_CANDIDATE_THRESHOLD=60

# Authentication / JWT (change the secret in any real deployment!)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Gemini API key for AI Assistant interrogation & hypothesis generation
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS allowed origins (comma-separated). In production set this to your Vercel URL.
# Example: ALLOWED_ORIGINS=https://crimelink.vercel.app
# Leave unset for local dev (defaults to http://localhost:5173).
ALLOWED_ORIGINS=https://your-app.vercel.app
